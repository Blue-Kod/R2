<?xml version="1.0"?>
<robot name="r2_arm_right">

  <!-- ==================== Links ==================== -->

  <link name="base_link">
    <visual>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="tilt_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <link name="upper_arm_link">
    <visual>
      <geometry><cylinder radius="0.020" length="0.330"/></geometry>
      <origin xyz="0 -0.165 0" rpy="0 0 0"/>
      <material name="arm"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.025" length="0.330"/></geometry>
      <origin xyz="0 -0.165 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 -0.165 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="forearm_link">
    <visual>
      <geometry><cylinder radius="0.015" length="0.220"/></geometry>
      <origin xyz="0 -0.110 0" rpy="0 0 0"/>
      <material name="forearm"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.020" length="0.220"/></geometry>
      <origin xyz="0 -0.110 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 -0.110 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <link name="ee_link">
    <visual>
      <geometry><sphere radius="0.012"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- ==================== Joints ==================== -->

  <!-- Pan: rotates around Y-axis, shoulder offset 115mm in X -->
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tilt_link"/>
    <origin xyz="0.115 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.927" upper="0.611" effort="100" velocity="100"/>
    <!-- -225deg..35deg in radians -->
  </joint>

  <!-- Tilt: rotates around -X in parent frame (coupled with pan) -->
  <joint name="tilt_joint" type="revolute">
    <parent link="tilt_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="100"/>
  </joint>

  <!-- Elbow: rotates around -X in parent frame -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.330 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="100"/>
  </joint>

  <!-- Fixed ee joint -->
  <joint name="ee_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="ee_link"/>
    <origin xyz="0 -0.220 0" rpy="0 0 0"/>
  </joint>

</robot>
